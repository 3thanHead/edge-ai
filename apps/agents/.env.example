# Copy to .env and fill in for this machine. No IPs belong in git.

# The cluster's HAProxy master endpoint (Ollama API).
LLM_BASE_URL=http://<master-ip>:11434
# Tool-calling-capable model served by the cluster.
LLM_MODEL=llama3.2:3b
# The ESP32's HTTP API.
IOT_DEVICE_URL=http://<esp32-ip>
# Broker the ESP32 connects to; "mosquitto" = the one in this compose file.
MQTT_HOST=mosquitto
AGENTS_PORT=8810
