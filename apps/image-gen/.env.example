# apps/image-gen -- copy to .env on the GPU box. Nothing secret here, but the
# file is gitignored like every other app's .env.

# HuggingFace repo id. schnell is Apache-2.0 (dev is NON-COMMERCIAL -- read the
# license before pointing this at dev for anything that sells).
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# schnell's WEIGHTS are gated even though its license is Apache-2.0: the repo
# needs a HuggingFace account that has accepted the terms on the model page,
# plus a read token. Without it the service dies at startup with a 401
# GatedRepoError. Either run `.venv/bin/hf auth login` once (stores a token in
# ~/.cache/huggingface) or set it here -- this file is gitignored.
# HF_TOKEN=hf_...

# 0.0.0.0 so the LAN can reach it. Must match the node's image_port in fleet.json.
IMAGE_HOST=0.0.0.0
IMAGE_PORT=8188

# nf4 = 4-bit transformer + text encoder (needed under ~16GB VRAM).
# bf16 = no quantization; only on a card with ~24GB+.
IMAGE_QUANT=nf4

# schnell defaults. For FLUX.1-dev use IMAGE_STEPS=28, IMAGE_GUIDANCE=3.5,
# IMAGE_MAX_SEQ=512.
IMAGE_STEPS=4
IMAGE_GUIDANCE=0.0
IMAGE_MAX_SEQ=256

# Where model weights cache (32GB for FLUX.1-schnell). Leave unset: the default
# (~/.cache/huggingface) is on the WSL filesystem. Avoid pointing it at /mnt/c
# even when Windows has room -- 9p access across the WSL boundary is slow
# enough to noticeably hurt model load times.
# HF_HOME=
