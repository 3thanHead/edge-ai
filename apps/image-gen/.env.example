# apps/image-gen -- copy to .env on the GPU box. Nothing secret here, but the
# file is gitignored like every other app's .env.

# HuggingFace repo id. klein is Apache-2.0, fully commercial, no self-host
# license fee, no gated-repo terms to accept (unlike FLUX.1-schnell/dev). It's
# a 4B distilled model -- fits a 12GB card at plain bf16, no quantization dance.
IMAGE_MODEL=black-forest-labs/FLUX.2-klein-4B

# Only needed if you point IMAGE_MODEL at a gated repo (e.g. rolling back to
# FLUX.1-schnell/dev): accept the terms on the model page while signed in,
# mint a read token, then either `.venv/bin/hf auth login` or set it here.
# HF_TOKEN=hf_...

# 0.0.0.0 so the LAN can reach it. Must match the node's image_port in fleet.json.
IMAGE_HOST=0.0.0.0
IMAGE_PORT=8188

# none = plain bf16 (klein's default -- already fits 12GB).
# nf4  = 4-bit transformer + text encoder -- only exercised by the FLUX.1
#        fallback path (FluxPipeline), for a 12B-class "dev" model on a small card.
IMAGE_QUANT=none

# klein's distilled defaults. For a "dev"-class FLUX.1/2 model instead, raise
# these: IMAGE_STEPS=28, IMAGE_GUIDANCE=3.5, IMAGE_MAX_SEQ=512.
IMAGE_STEPS=4
IMAGE_GUIDANCE=0.0
IMAGE_MAX_SEQ=256

# Where model weights cache. Leave unset: the default (~/.cache/huggingface) is
# on the WSL filesystem. Avoid pointing it at /mnt/c even when Windows has
# room -- 9p access across the WSL boundary is slow enough to noticeably hurt
# model load times.
# HF_HOME=
